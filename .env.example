# Copy this file to .env and replace the placeholder.
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SPEECH_MODEL=tts-1
OPENAI_SPEECH_VOICE=nova
OPENAI_REALTIME_ENABLED=true
OPENAI_REALTIME_MODEL=gpt-realtime-2.1-mini
OPENAI_REALTIME_PREWARM=true

# Optional legacy connector tokens. Prefer scripts/connect_accounts.ps1, which
# stores refreshable credentials in Windows Credential Manager.
# DESKBOB_GMAIL_OAUTH_TOKEN=
# DESKBOB_GOOGLE_CALENDAR_OAUTH_TOKEN=
# DESKBOB_GOOGLE_DRIVE_OAUTH_TOKEN=
# DESKBOB_OUTLOOK_CALENDAR_OAUTH_TOKEN=
# DESKBOB_OUTLOOK_EMAIL_OAUTH_TOKEN=
# DESKBOB_MICROSOFT_TEAMS_OAUTH_TOKEN=
# DESKBOB_SHAREPOINT_OAUTH_TOKEN=
# DESKBOB_DROPBOX_OAUTH_TOKEN=
