# Copy this file to .env and replace the placeholder.
OPENAI_API_KEY=your-api-key-here
OPENAI_MODEL=gpt-5.6
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
OPENAI_SPEECH_MODEL=tts-1
OPENAI_SPEECH_VOICE=nova

